@top Template { (directive | Text)* }

directive {
  Insert |
  Escape |
  RawBlock |
  BlockComment |
  OnelineComment
}

Insert { "{{" (space* (Expression | "|" | "^" | "~"))*  space* "}}" }

Escape { "{{{" (space* (Expression | "|" | "^" | "~"))*  space* "}}}" }

Expression {
  PropertyAccess |
  BracketExpression |
  Identifier |
  BIHelper |
  Number |
  Bool |
  String |
  Equa |
  Subexp
}

// Simplified property access
PropertyAccess { Identifier (DotProperty)+ }
DotProperty { dot Identifier }
BracketExpression { Identifier "[" Number "]" }

RawOpen { "{{{{" Any "}}}}" }
RawClose { "{{{{/" Any "}}}}" }
RawBlock { RawOpen (directive | Text)* RawClose }

@local tokens {
  blockCommentEnd { "--}}" }
  blockCommentNewline { "\n" }
  @else blockCommentContent
}

@skip {} {
  BlockComment { "{{!--" (blockCommentContent | blockCommentNewline)* blockCommentEnd }
}
@skip { spaces | newline }

@local tokens {
  oneLineCommentEnd { "}}" }
  @else oneLineCommentContent
}

@skip {} {
  OnelineComment { "{{!" oneLineCommentContent* oneLineCommentEnd }
}

@context trackNewline from "./tokens.js"

Bool { @specialize<Identifier, "true" | "false"> }
Equa { Identifier "=" (Identifier | Number | Bool | String) }
Subexp { "(" (space* (Expression | "|"))*  space* ")" }

@tokens {
  spaces[@export] { $[\u0009 \u000b\u00a0\u1680\u2000-\u200a\u202f\u205f\u3000\ufeff]+ }
  newline[@export] { $[\r\n\u2028\u2029] }
  
  identifierChar { @asciiLetter | $[_$\u{a1}-\u{10ffff}] | "@" }
  
  // Just handle all identifiers the same way, including paths
  // This deliberately includes "../" and "./" as possible identifier patterns
  Identifier { identifierChar (identifierChar | @digit | "/" | "." | "#" | "-" | "_")* }

  BIHelper { ("#"|"/"|"*") Identifier | "else" | "else if" | ">" }
  
  Text { ![{] Text? | "{" (@eof | ![{] Text?) }
  hex { @digit | $[a-fA-F] }

  Any { (![{|}])+ }

  String { ("'" (![\\'] | "\\" _)* "'"?) | ("\"" (![\\"] | "\\" _)* "\""?) }
  
  // Use a separate token for the dot in property access to avoid conflicts
  dot { "." }
  
  Number {
    // Dot in number contexts
    (@digit ("_" | @digit)* (dot ("_" | @digit)*)? | dot @digit ("_" | @digit)*)
      (("e" | "E") ("+" | "-")? ("_" | @digit)+)? |
    @digit ("_" | @digit)* "n" |
    "0x" (hex | "_")+ "n"? |
    "0b" $[01_]+ "n"? |
    "0o" $[0-7_]+ "n"?
  }

  space { @whitespace+ }
  
  @precedence { Number, dot }
  @precedence { dot, Identifier }
  @precedence { space, BIHelper, Identifier }
  @precedence { spaces, newline, Identifier }
  @precedence { spaces, newline, Text }
  @precedence { Any, spaces, newline }
  @precedence { spaces, newline, space }
  
  "{{"
  "}}"
  "~"
  "["
  "]"
}

@external propSource Highlight from "./highlight.js"